---
import Layout from "../layouts/Layout.astro";

const experiences = [
  {
    title: "Senior Software Developer",
    company: "College Loan Corporation",
    period: "August 2020 – Present",
    bullets: [
      "Improved Lighthouse scores from a C to an A across company properties.",
      "Reduced development time by 40% by consolidating 6 projects into a monorepo.",
      "Cleared thousands of legacy WCAG violations.",
      "Led the design and development of multiple financial calculators.",
      "Built custom low-code data-viz extensions for our data science products."
    ]
  },
  {
    title: "Frontend Web Developer",
    company: "Vegas.com",
    period: "September 2019 – March 2020",
    bullets: [
      "Increased conversion rates through data-driven A/B testing of high-traffic pages.",
      "Established formal testing and component patterns improving code stability across React and legacy codebases."
    ]
  },
  {
    title: "Frontend Developer III",
    company: "Konami Gaming Inc.",
    period: "June 2018 – September 2019",
    bullets: [
      "Revolutionized 20-year-old Java interfaces by engineering a React-based thick client with embedded Chromium.",
      "Eliminated substantial Oracle licensing costs by researching and deploying an open-source Chromium integration framework for Java.",
      "Served as the resident React lead, standardizing production pipelines and DevOps best practices."
    ]
  },
  {
    title: "Ed Tech Course Designer",
    company: "1Prospect Technologies",
    period: "October 2017 – February 2018",
    bullets: [
      "Designed mission-critical UI for instructional modules used by personnel in active military zones.",
      "Engineered a rapid development pipeline that accelerated production for small-scale course materials."
    ]
  },
  {
    title: "Lead Developer",
    company: "Distance Course Design & Consulting, University of Hawaii",
    period: "August 2015 – October 2017",
    bullets: [
      "Reduced second-site build time by 90% (from 1 year to 1 month) by engineering a reusable parent theme architecture.",
      "Built a secure, enterprise WordPress portal for HR featuring role-based PDF rendering and custom navigation walkers.",
      "Developed the \"Roots Course\" framework enabling structured e-learning with xAPI/LRS integration and assessments."
    ]
  },
  {
    title: "Front End Project Manager",
    company: "Superb.net",
    period: "August 2014 – August 2015",
    bullets: [
      "Modernized antiquated web infrastructures with responsive layouts, automated build tools, and modern CSS preprocessors.",
      "Implemented Agile planning and standardized coding protocols to increase team velocity and project predictability."
    ]
  },
  {
    title: "Software Developer",
    company: "Leicher Web Design",
    period: "August 2011 – April 2014",
    bullets: [
      "Architected data-driven reporting systems using SVG-based charting APIs and server-side PDF generation."
    ]
  },
  {
    title: "Software Developer",
    company: "Automata Studios",
    period: "October 2009 – April 2012",
    bullets: [
      "Engineered highly visible interactive installations for clients including IBM (Watson Jeopardy project) and the Smithsonian.",
      "Developed cross-platform mobile reader applications for the Barnes & Noble Nook Color using ActionScript and JavaScript."
    ]
  }
];

const domains = ["Front End", "UI", "UX", "Tools", "DevOps"];
---

<Layout title="CV - Joel Stransky | Senior Software Engineer">
  <main class="w-full bg-surface-primary text-foreground-primary transition-colors duration-300">
    <div class="mx-auto px-6 md:px-24 max-w-4xl py-16 md:py-24">
      
      <!-- Header / Contact Info -->
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 pb-8 border-b border-border-subtle">
        <div>
          <h1 class="font-serif font-bold text-4xl md:text-5xl text-foreground-primary tracking-tight m-0">
            Joel Stransky
          </h1>
          <p class="font-sans text-xl md:text-2xl text-accent-primary font-medium mt-2 mb-3">
            Senior Software Engineer
          </p>
          <p class="font-sans text-sm text-foreground-secondary m-0 flex flex-wrap items-center gap-x-3 gap-y-1">
            <span>Las Vegas, NV</span>
            <span class="text-border-card">•</span>
            <a href="mailto:stranskydesign@gmail.com" class="text-foreground-secondary hover:text-accent-primary transition-colors no-underline">
              stranskydesign@gmail.com
            </a>
          </p>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-3 font-sans text-xs md:text-sm text-foreground-secondary">
            <a href="https://joelstransky.netlify.app" class="hover:text-accent-primary transition-colors no-underline">
              joelstransky.netlify.app
            </a>
            <span class="text-border-card">•</span>
            <a href="https://linkedin.com/in/joelstransky/" target="_blank" rel="noopener noreferrer" class="hover:text-accent-primary transition-colors no-underline">
              linkedin.com/in/joelstransky
            </a>
            <span class="text-border-card">•</span>
            <a href="https://github.com/joelstransky" target="_blank" rel="noopener noreferrer" class="hover:text-accent-primary transition-colors no-underline">
              github.com/joelstransky
            </a>
          </div>
        </div>

        <div class="shrink-0 pt-2 md:pt-0">
          <a
            href="/Joel-Stransky-Developer-Resume.pdf"
            target="_blank"
            download="Joel-Stransky-Developer-Resume.pdf"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full font-sans text-xs md:text-sm font-bold bg-[#534aff] text-white dark:bg-accent-primary dark:text-[#060414] hover:bg-opacity-90 transition-colors shadow-sm no-underline"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Download PDF
          </a>
        </div>
      </div>

      <!-- Summary -->
      <section class="py-10 border-b border-border-subtle">
        <h2 class="font-serif font-bold text-2xl text-foreground-primary mb-4">
          Professional Summary
        </h2>
        <p class="font-sans text-base md:text-lg text-foreground-secondary leading-relaxed m-0">
          Senior developer specializing in performance, accessibility, and scale. Strong design background, 15+ years producing enterprise software. Shipped on a variety of platforms including Node.js and .NET. Showcased on Jeopardy!, Nook Color and the Smithsonian.
        </p>
        
        <!-- Domains / Focus Badges -->
        <div class="flex flex-wrap gap-2 mt-6">
          {domains.map(domain => (
            <span class="px-3.5 py-1 rounded-full border border-border-card text-xs font-sans font-medium text-foreground-secondary bg-surface-secondary">
              {domain}
            </span>
          ))}
        </div>
      </section>

      <!-- Experience -->
      <section class="py-10 border-b border-border-subtle">
        <h2 class="font-serif font-bold text-2xl text-foreground-primary mb-8">
          Experience
        </h2>

        <div class="flex flex-col gap-10">
          {experiences.map(exp => (
            <div class="rounded border border-border-card bg-surface-secondary p-6 md:p-8 transition-colors">
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-2">
                <h3 class="font-serif font-bold text-xl md:text-2xl text-foreground-primary m-0">
                  {exp.title}
                </h3>
                <span class="font-sans text-xs md:text-sm text-foreground-muted uppercase tracking-wider font-medium shrink-0">
                  {exp.period}
                </span>
              </div>
              <p class="font-sans text-sm md:text-base text-accent-primary font-medium m-0 mb-4">
                {exp.company}
              </p>
              <ul class="list-disc pl-5 space-y-2 text-foreground-secondary font-sans text-sm md:text-base leading-relaxed m-0">
                {exp.bullets.map(bullet => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- Education -->
      <section class="pt-10">
        <h2 class="font-serif font-bold text-2xl text-foreground-primary mb-4">
          Education
        </h2>
        <div class="rounded border border-border-card bg-surface-secondary p-6 md:p-8">
          <h3 class="font-serif font-bold text-lg md:text-xl text-foreground-primary m-0">
            Full Sail University
          </h3>
          <p class="font-sans text-sm md:text-base text-foreground-secondary mt-1 m-0">
            B.S. Game Art <span class="text-accent-primary font-medium">(Salutatorian)</span>
          </p>
        </div>
      </section>

    </div>
  </main>
</Layout>
