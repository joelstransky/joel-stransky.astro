---
// Halloween ambient visual decorations
// Non-intrusive, pointer-events: none, respects prefers-reduced-motion
---

<div class="halloween-layer fixed inset-0 overflow-hidden pointer-events-none z-30" aria-hidden="true">
  <!-- Top-Right Cobweb -->
  <div class="absolute top-0 right-0 w-36 h-36 md:w-56 md:h-56 opacity-40 dark:opacity-60 text-[#ff7518] dark:text-[#a855f7] transition-opacity duration-500">
    <svg viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="1.2" class="w-full h-full">
      <!-- Radiating anchor threads from top-right corner (200, 0) -->
      <line x1="200" y1="0" x2="0" y2="0" />
      <line x1="200" y1="0" x2="20" y2="60" />
      <line x1="200" y1="0" x2="60" y2="120" />
      <line x1="200" y1="0" x2="110" y2="170" />
      <line x1="200" y1="0" x2="160" y2="195" />
      <line x1="200" y1="0" x2="200" y2="200" />
      <!-- Concentric web arcs -->
      <path d="M 180,0 Q 182,18 200,20" />
      <path d="M 155,0 Q 160,35 200,45" />
      <path d="M 125,0 Q 135,55 175,85 Q 190,70 200,75" />
      <path d="M 90,0 Q 105,75 145,120 Q 170,110 200,115" />
      <path d="M 50,0 Q 70,105 110,155 Q 145,150 180,175 Q 192,160 200,165" />
      <path d="M 10,0 Q 35,135 80,180 Q 120,185 155,195 Q 180,198 200,200" />
    </svg>
  </div>

  <!-- Top-Left Cobweb with Hanging Spider -->
  <div class="absolute top-0 left-0 w-32 h-32 md:w-48 md:h-48 opacity-35 dark:opacity-50 text-[#ff7518] dark:text-[#a855f7] transition-opacity duration-500">
    <svg viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="1.2" class="w-full h-full">
      <!-- Radiating threads from top-left (0, 0) -->
      <line x1="0" y1="0" x2="200" y2="0" />
      <line x1="0" y1="0" x2="180" y2="50" />
      <line x1="0" y1="0" x2="135" y2="120" />
      <line x1="0" y1="0" x2="75" y2="170" />
      <line x1="0" y1="0" x2="0" y2="200" />
      <!-- Web arcs -->
      <path d="M 25,0 Q 20,20 0,25" />
      <path d="M 60,0 Q 45,45 0,60" />
      <path d="M 105,0 Q 80,85 0,105" />
      <path d="M 155,0 Q 120,130 0,155" />
    </svg>
  </div>

  <!-- Dangling Spider (Left side) -->
  <div class="absolute top-0 left-12 md:left-24 animate-spider opacity-75 dark:opacity-90">
    <!-- Thread -->
    <div class="w-[1px] h-16 md:h-24 bg-border-primary dark:bg-[#7d658f] mx-auto"></div>
    <!-- Spider Body & Legs -->
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="text-foreground-primary">
      <!-- Spider abdomen & cephalothorax -->
      <ellipse cx="12" cy="14" rx="4" ry="5" />
      <circle cx="12" cy="8" r="2.5" />
      <!-- Eyes -->
      <circle cx="11" cy="7.5" r="0.6" fill="#ff7518" />
      <circle cx="13" cy="7.5" r="0.6" fill="#ff7518" />
      <!-- Left Legs -->
      <path d="M9 8 C5 6, 4 9, 3 10" stroke="currentColor" stroke-width="1" fill="none" />
      <path d="M9 10 C5 9, 3 12, 2 14" stroke="currentColor" stroke-width="1" fill="none" />
      <path d="M9 12 C5 12, 4 16, 3 18" stroke="currentColor" stroke-width="1" fill="none" />
      <path d="M9 14 C6 15, 5 19, 5 21" stroke="currentColor" stroke-width="1" fill="none" />
      <!-- Right Legs -->
      <path d="M15 8 C19 6, 20 9, 21 10" stroke="currentColor" stroke-width="1" fill="none" />
      <path d="M15 10 C19 9, 21 12, 22 14" stroke="currentColor" stroke-width="1" fill="none" />
      <path d="M15 12 C19 12, 20 16, 21 18" stroke="currentColor" stroke-width="1" fill="none" />
      <path d="M15 14 C18 15, 19 19, 19 21" stroke="currentColor" stroke-width="1" fill="none" />
    </svg>
  </div>

  <!-- Subtle Floating Bat (Upper right quadrant) -->
  <div class="absolute top-28 right-16 md:right-36 animate-bat opacity-30 dark:opacity-45 text-foreground-primary">
    <svg width="34" height="20" viewBox="0 0 34 20" fill="currentColor">
      <path d="M17 10 C15 7, 12 4, 7 5 C3 5.8, 1 9, 0 12 C3 11, 6 12, 8 15 C10 12, 13 13, 15 17 C16 14, 16 11, 17 11 C18 11, 18 14, 19 17 C21 13, 24 12, 26 15 C28 12, 31 11, 34 12 C33 9, 31 5.8, 27 5 C22 4, 19 7, 17 10 Z" />
    </svg>
  </div>

  <!-- Subtle Drifting Friendly Ghost (Lower right background) -->
  <div class="hidden lg:block absolute bottom-24 right-10 animate-ghost opacity-25 dark:opacity-35 text-[#ff7518] dark:text-[#d4c2e2]">
    <svg width="42" height="52" viewBox="0 0 42 52" fill="currentColor">
      <path d="M21 2 C10 2, 2 10, 2 22 C2 32, 4 44, 4 48 C6 46, 9 46, 12 48 C15 50, 18 50, 21 48 C24 46, 27 46, 30 48 C33 50, 36 50, 38 48 C38 44, 40 32, 40 22 C40 10, 32 2, 21 2 Z" />
      <!-- Ghost Eyes and Mouth -->
      <circle cx="15" cy="18" r="2.5" fill="#0a0512" />
      <circle cx="27" cy="18" r="2.5" fill="#0a0512" />
      <ellipse cx="21" cy="26" rx="2" ry="3.5" fill="#0a0512" />
    </svg>
  </div>
</div>
