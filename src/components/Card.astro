---
import { Image } from "astro:assets";

const {
  slug,
  title,
  image,
  tags,
  index,
  body,
  section,
  isFeatured = false,
  hasWeb = (index % 3 === 0 && !isFeatured),
} = Astro.props;

const borderClass = 'border-card';
const textColors = ['text-accent-tertiary', 'text-accent-primary', 'text-accent-secondary'];
const textClass = textColors[index % 3];

// Extract first paragraph for card description
const cleanDescription = (bodyText: string) => {
  if (!bodyText) return "";
  const paragraphs = bodyText
    .split(/\n\s*\n/)
    .map(p => p.trim())
    .filter(p => p && 
                 !p.startsWith("import") && 
                 !p.startsWith("<") && 
                 !p.startsWith("#") && 
                 !p.startsWith("![") && 
                 !p.startsWith("[![")
    );
  
  let paragraph = paragraphs[0] || "";
  
  // Clean markdown styles
  paragraph = paragraph
    .replace(/\*\*([^*]+)\*\*/g, '$1')
    .replace(/\*([^*]+)\*/g, '$1')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');
    
  if (paragraph.length > 180) {
    paragraph = paragraph.slice(0, 177) + "...";
  }
  return paragraph;
};

const description = cleanDescription(body || "");
---

<figure class={`flex flex-col rounded border ${borderClass} transition-all duration-300 hover:shadow-md hover:scale-[1.01] relative w-full ${isFeatured ? 'bg-transparent lg:flex-row lg:items-center lg:gap-8 p-6 lg:p-8 lg:col-span-2' : 'bg-surface-secondary gap-3 md:gap-4 p-4'}`}>

  <!-- Corner cobweb on card itself (Halloween sub-theme, select cards only) -->
  {hasWeb && (
    <div class="halloween-decoration absolute top-0 right-0 w-12 h-12 md:w-16 md:h-16 pointer-events-none text-[#ff7518] dark:text-[#a855f7] opacity-40 dark:opacity-55 z-10" aria-hidden="true">
      <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.2" class="w-full h-full">
        <line x1="100" y1="0" x2="0" y2="0" />
        <line x1="100" y1="0" x2="0" y2="100" />
        <line x1="100" y1="0" x2="100" y2="100" />
        <path d="M 80 0 Q 80 20 100 20" />
        <path d="M 55 0 Q 55 45 100 45" />
        <path d="M 25 0 Q 25 75 100 75" />
      </svg>
    </div>
  )}

  {isFeatured ? (
    <!-- Horizontal Featured Card Layout -->
    <a
      href={`/article/${slug}`}
      class="no-underline shrink-0 block overflow-hidden rounded border border-border-subtle bg-surface-primary w-full sm:w-[240px] lg:w-[420px] aspect-[5/3] order-first lg:order-2"
      aria-label={title}
    >
      <span class="relative block h-full w-full transition duration-500 ease-in-out transform hover:scale-105">
        <Image
          width={420}
          height={252}
          fit="cover"
          densities={[1, 2]}
          class="relative block object-cover w-full h-full"
          loading="lazy"
          alt={title}
          src={image}
        />
      </span>
    </a>

    <div class="flex flex-col gap-4 flex-1 min-w-0 mt-4 lg:mt-0 order-last lg:order-1">
      <div class="flex flex-col gap-2">
        <p class={`font-sans text-[10px] sm:text-[11px] tracking-wider ${textClass} font-medium uppercase m-0 leading-none inline-flex items-center gap-1.5`}>
          FEATURED CASE STUDY • {tags.map((t: string) => t.toUpperCase()).join(" • ")}
          <span class="halloween-decoration text-xs select-none" aria-hidden="true">🎃</span>
        </p>
        <h3 class="font-serif font-bold text-xl sm:text-2xl lg:text-3xl text-foreground-primary m-0 leading-tight">
          <a
            href={`/article/${slug}`}
            class="no-underline hover:text-accent-primary transition-colors duration-300"
            aria-label={title}
          >
            {title}
          </a>
        </h3>
      </div>

      {description && (
        <p class="font-sans text-sm lg:text-base text-foreground-secondary leading-relaxed m-0">
          {description}
        </p>
      )}

      <div class="mt-2">
        <a
          href={`/article/${slug}`}
          class="inline-flex items-center justify-center px-6 py-2.5 rounded-full font-sans text-xs md:text-sm font-bold bg-[#534aff] text-white dark:bg-accent-primary dark:text-[#060414] hover:bg-opacity-90 transition-colors duration-300 no-underline shadow-sm hover:shadow"
        >
          Read case study
        </a>
      </div>
    </div>
  ) : (
    <!-- Original Card Layout -->
    <div class="flex gap-4 items-center">
      <!-- Thumbnail -->
      <a
        href={`/article/${slug}`}
        class="no-underline shrink-0 block overflow-hidden rounded border border-border-subtle bg-surface-primary w-[110px] sm:w-[150px] lg:w-[220px] aspect-[5/3]"
        aria-label={title}
      >
        <span class="relative block h-full w-full transition duration-500 ease-in-out transform hover:scale-105">
          <Image
            width={220}
            height={132}
            fit="cover"
            densities={[1, 2]}
            class="relative block object-cover w-full h-full"
            loading="lazy"
            alt={title}
            src={image}
          />
        </span>
      </a>

      <!-- Meta Col -->
      <div class="flex flex-col gap-1.5 flex-1 min-w-0 pr-6">
        <h3 class="font-serif font-bold text-base sm:text-lg lg:text-xl text-foreground-primary m-0 leading-tight">
          <a
            href={`/article/${slug}`}
            class="no-underline hover:text-accent-primary transition-colors duration-300"
            aria-label={title}
          >
            {title}
          </a>
        </h3>
        <p class={`font-sans text-[9px] sm:text-[10px] tracking-wider ${textClass} font-medium uppercase m-0 leading-none inline-flex items-center gap-1.5`}>
          {tags.map((t: string) => t.toUpperCase()).join(" • ")}
          <span class="halloween-decoration text-[11px] select-none" aria-hidden="true">
            {index % 3 === 0 ? '🦇' : index % 3 === 1 ? '🎃' : '🕸️'}
          </span>
        </p>
      </div>
    </div>

    <!-- Bottom Row: Description & Read More -->
    <div class="flex flex-col gap-2.5 mt-1">
      {description && (
        <p class="font-sans text-xs md:text-sm text-foreground-secondary leading-relaxed m-0">
          {description}
        </p>
      )}
      <a
        href={`/article/${slug}`}
        class={`font-sans text-xs md:text-sm font-bold ${textClass} hover:text-foreground-primary transition-colors duration-300 inline-flex items-center gap-1 no-underline`}
      >
        Read more &rarr;
      </a>
    </div>
  )}
</figure>
